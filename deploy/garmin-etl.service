# Jednorazowy przebieg ETL: dociaga brakujace dni i przebudowuje tabele.
# Odpalany przez garmin-etl.timer, nie wlaczaj go przez "systemctl enable".
# Kod wyjscia 2 znaczy "token Garmina wygasl" - wtedy trzeba sie zalogowac
# recznie przez etl/login.py.
[Unit]
Description=Garmin Dashboard ETL
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=garmin
Group=garmin
WorkingDirectory=/opt/garmin-dashboard
Environment=HOME=/home/garmin
Environment=GARMIN_TOKENSTORE=/home/garmin/.garminconnect
ExecStart=/opt/garmin-dashboard/.venv/bin/python etl/run.py --days 14
# Liczniki zasobow: `systemctl status` pokazuje wtedy Memory (biezaca i szczyt)
# i CPU, a `systemd-cgtop` na zywo - patrz DEPLOY.md, sekcja 8.
MemoryAccounting=yes
CPUAccounting=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
