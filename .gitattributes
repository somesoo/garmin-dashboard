* text=auto

# Pliki czytane przez Linuxa musza miec konce linii LF, nawet gdy repo jest
# klonowane na Windowsie.
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
*.sh        text eol=lf
*.py        text eol=lf

# Batch dla Windowsa wymaga CRLF.
*.cmd       text eol=crlf

# Binaria i dane - bez konwersji.
*.parquet   binary
*.json      -text
